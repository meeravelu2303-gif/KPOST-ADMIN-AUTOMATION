BASE_URL=http://localhost:9595
API_TIMEOUT=30000
TEST_WORKERS=4

# --- Authentication -------------------------------------------------------
# The Admin Module's login (userDetails/login) returns identity fields only and NO token
# (see SignUpResponse). The authentication filter accepts an HS256 JWT signed with the
# backend's dev secret, reading the `sub` (kpostID) and `companyID` claims from it.
#
# Preferred: paste a real access token issued by the platform.
QA_AUTH_TOKEN=
# Fallback: when QA_AUTH_TOKEN is empty, the framework MINTS a short-lived HS256 token from
# the values below. ADMIN_JWT_SECRET must match the server's signing key, otherwise the
# minted token is rejected and the run proceeds unauthenticated (with a diagnostic).
#
# Enter this EXACTLY as the backend declares it (AuthenticationUtility.secretKey). It is
# BASE64-DECODED before signing, because the backend verifies with jjwt's
# `setSigningKey(String)`, which treats a String key as base64. Do not "fix" a 401 by
# base64-encoding this value yourself — authSession.ts already does the decode.
ADMIN_JWT_SECRET=kJuImTaErN0D9R0A7
ADMIN_JWT_TTL_SECONDS=3600
# Identity baked into a minted token. companyID is what tenant-scoped endpoints read from
# the request attributes the filter injects.
QA_KPOST_ID=qa.admin
QA_COMPANY_ID=1001

# Credentials for a pre-seeded login (used only to prove the login contract, since login
# yields no usable session token on this module).
QA_USER_ID=
QA_PASSWORD=

# --- OTP handling ---------------------------------------------------------
# userDetails/sendOTP reaches a real handset and costs money; it is unauthenticated and
# unthrottled. Every OTP-dispatching test routes to this single safe destination.
TEST_MOCK_OTP=123456
TEST_MOCK_OTP_FALLBACK=000000
TEST_MOBILE=9999999999
TEST_EMAIL=qa-test@example.com
TEST_DIAL_CODE=91

# --- Diagnostics ----------------------------------------------------------
VERBOSE_AUTH_DIAGNOSTICS=true

# --- Reporting engine -----------------------------------------------------
# The environment label on every report header and the QA Dashboard's grouping key. Inferred
# from BASE_URL when unset (localhost -> Local); alias ENVIRONMENT is also accepted. This is
# the short label, never the raw URL — the URL is published separately as `baseURL`.
TEST_ENV=
# Name on the report header; alias TESTER.
QA_ENGINEER=
# Timestamped run folders kept under reports/runs/. 0 = keep forever.
KPOST_RUN_RETENTION=20
# Vector-coverage gate percentage; `npm test` runs the audit first and fails below this.
KPOST_VECTOR_THRESHOLD=98

# Set by tooling, not by hand:
#   KPOST_RUN_SEED   registers the opt-in seed project; `npm run seed` sets it.
#   CI               switches to 2 workers, 1 retry and forbidOnly.

# --- Dispatchers (all optional; each one skips cleanly when unset) ---------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
DEV_EMAIL_RECIPIENTS=

WEBHOOK_URL=

TRACKER_API_KEY=
PLANE_API_URL=
PLANE_WORKSPACE_SLUG=
PLANE_PROJECT_ID=
REDMINE_API_URL=
REDMINE_PROJECT_ID=

# --- External QA Dashboard ------------------------------------------------
# Publishes each finished run (BUG_REPORT.json) to the QA Dashboard. The ingest reporter runs
# LAST in playwright.config.ts and is fail-safe: with either value unset it prints one
# "ingest skipped" line and can never change the run's exit code.
#
# Create the application in the QA Dashboard's Applications page under the slug `kpost-admin`
# ("KPost Admin Module"); the page issues the API key below.
DASHBOARD_INGEST_URL=
DASHBOARD_API_KEY=
